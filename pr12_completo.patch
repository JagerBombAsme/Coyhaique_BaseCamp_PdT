diff --git a/lib/features/map/presentation/widgets/offline_map_canvas.dart b/lib/features/map/presentation/widgets/offline_map_canvas.dart
new file mode 100644
index 0000000..6e0c60b
--- /dev/null
+++ b/lib/features/map/presentation/widgets/offline_map_canvas.dart
@@ -0,0 +1,183 @@
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+
+import '../../../../core/theme/basecamp_tokens.dart';
+import '../map_places.dart';
+
+/// Radio del mapa sin conexión, en km alrededor del centro de Coyhaique.
+const double offlineRadiusKm = 50;
+
+/// Mapa sin conexión: sin teselas, dibuja los lugares dentro de
+/// [offlineRadiusKm] sobre un plano proyectado desde el centro. Usa solo los
+/// datos ya descargados, así que no necesita internet.
+class OfflineMapCanvas extends StatelessWidget {
+  const OfflineMapCanvas({
+    super.key,
+    required this.center,
+    required this.places,
+    required this.selected,
+    required this.onSelect,
+    required this.isSpanish,
+  });
+
+  final MapPlace center;
+  final List<MapPlace> places;
+  final MapPlace selected;
+  final ValueChanged<MapPlace> onSelect;
+  final bool isSpanish;
+
+  @override
+  Widget build(BuildContext context) {
+    return LayoutBuilder(
+      builder: (context, constraints) {
+        final size = constraints.biggest;
+        final layout = _OfflineLayout(center: center, size: size);
+        // El aeropuerto se muestra siempre: queda a unos 48 km del centro,
+        // justo en el borde del radio, y es el punto de llegada de los transfers.
+        final inRange = places
+            .where(
+              (place) =>
+                  layout.isInRange(place) ||
+                  place.nameEs == MapPlaces.airport.nameEs,
+            )
+            .toList();
+
+        return GestureDetector(
+          behavior: HitTestBehavior.opaque,
+          onTapUp: (details) {
+            final hit = layout.nearest(inRange, details.localPosition);
+            if (hit != null) onSelect(hit);
+          },
+          child: Semantics(
+            label: isSpanish
+                ? 'Mapa sin conexión: lugares a menos de 50 km de Coyhaique'
+                : 'Offline map: places within 50 km of Coyhaique',
+            child: CustomPaint(
+              size: size,
+              painter: _OfflineMapPainter(
+                layout: layout,
+                places: inRange,
+                selected: selected,
+              ),
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
+
+/// Proyección plana alrededor del centro. Basta para 50 km.
+class _OfflineLayout {
+  _OfflineLayout({required this.center, required this.size})
+    : scale = _fitScale(size);
+
+  static const double _kmPerDegLat = 111.2;
+
+  final MapPlace center;
+  final Size size;
+
+  /// Píxeles por km, para que el círculo de 50 km quepa con margen.
+  final double scale;
+
+  static double _fitScale(Size size) {
+    return (size.shortestSide / 2 - 24) / offlineRadiusKm;
+  }
+
+  double get _kmPerDegLng =>
+      _kmPerDegLat * math.cos(center.latitude * math.pi / 180);
+
+  /// Desplazamiento en km desde el centro hacia el este (x) y el sur (y).
+  Offset _kmOffset(double lat, double lng) {
+    final dxKm = (lng - center.longitude) * _kmPerDegLng;
+    final dyKm = (center.latitude - lat) * _kmPerDegLat;
+    return Offset(dxKm, dyKm);
+  }
+
+  bool isInRange(MapPlace place) {
+    final km = _kmOffset(place.latitude, place.longitude).distance;
+    return km <= offlineRadiusKm;
+  }
+
+  Offset project(double lat, double lng) {
+    return size.center(Offset.zero) + _kmOffset(lat, lng) * scale;
+  }
+
+  /// El lugar más cercano al toque, si está a menos de 28 px.
+  MapPlace? nearest(List<MapPlace> places, Offset tap) {
+    MapPlace? best;
+    var bestDistance = 28.0;
+    for (final place in places) {
+      final distance = (project(place.latitude, place.longitude) - tap)
+          .distance;
+      if (distance < bestDistance) {
+        bestDistance = distance;
+        best = place;
+      }
+    }
+    return best;
+  }
+}
+
+class _OfflineMapPainter extends CustomPainter {
+  _OfflineMapPainter({
+    required this.layout,
+    required this.places,
+    required this.selected,
+  });
+
+  final _OfflineLayout layout;
+  final List<MapPlace> places;
+  final MapPlace selected;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final centerPx = size.center(Offset.zero);
+    final radiusPx = offlineRadiusKm * layout.scale;
+
+    canvas.drawRect(Offset.zero & size, Paint()..color = BcColors.fog);
+    canvas.drawCircle(centerPx, radiusPx, Paint()..color = BcColors.surface);
+
+    final ringPaint = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 1
+      ..color = BcColors.line;
+    for (final km in [10.0, 25.0]) {
+      canvas.drawCircle(centerPx, km * layout.scale, ringPaint);
+    }
+
+    canvas.drawCircle(
+      centerPx,
+      radiusPx,
+      Paint()
+        ..style = PaintingStyle.stroke
+        ..strokeWidth = 2
+        ..color = BcColors.glacierDeep,
+    );
+
+    for (final place in places) {
+      final isSelected = identical(place, selected);
+      final pos = layout.project(place.latitude, place.longitude);
+      final r = isSelected ? 10.0 : 7.0;
+      canvas.drawCircle(
+        pos,
+        r,
+        Paint()..color = isSelected ? BcColors.ink : BcColors.glacier,
+      );
+      canvas.drawCircle(
+        pos,
+        r,
+        Paint()
+          ..style = PaintingStyle.stroke
+          ..strokeWidth = 2
+          ..color = BcColors.ink,
+      );
+    }
+
+    canvas.drawCircle(centerPx, 4, Paint()..color = BcColors.ink);
+  }
+
+  @override
+  bool shouldRepaint(_OfflineMapPainter old) => true;
+}
