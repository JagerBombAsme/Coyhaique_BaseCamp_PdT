diff --git a/test/route_tracking_test.dart b/test/route_tracking_test.dart
new file mode 100644
index 0000000..414d697
--- /dev/null
+++ b/test/route_tracking_test.dart
@@ -0,0 +1,28 @@
+import 'package:coyhaique_basecamp_pt/features/map/domain/route_tracking.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  // Ruta de prueba de oeste a este, sobre la latitud -45,57. Formato [lng, lat].
+  final route = [
+    [-72.07, -45.57],
+    [-72.05, -45.57],
+  ];
+
+  test('a point on the route is at distance zero', () {
+    expect(distanceToRouteMeters(-45.57, -72.06, route), closeTo(0, 1));
+  });
+
+  test('a point about 1 km north of the route is about 1 km away', () {
+    // 0,009° de latitud equivalen a cerca de 1 km.
+    expect(distanceToRouteMeters(-45.561, -72.06, route), closeTo(1000, 30));
+  });
+
+  test('a point past the end of the route is measured to the end', () {
+    // 0,05° de longitud a esa latitud son cerca de 3,9 km.
+    expect(distanceToRouteMeters(-45.57, -72.0, route), closeTo(3885, 40));
+  });
+
+  test('an empty route is infinitely far', () {
+    expect(distanceToRouteMeters(-45.57, -72.06, const []), double.infinity);
+  });
+}
